tools/_online_rooms.json

# 运行期日志与临时产物
_*.log
_*.txt
*.pyc
__pycache__/
.venv/

# 公网发布副本（含真实 Key）。它本来就在项目目录之外，写上只为万一挪了仓库根
.deploy/
